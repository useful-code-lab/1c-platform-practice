Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Обязательно включаем запись движений, чтобы платформа очищала старые движения при перепроведении
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	
	// 2. Подготавливаем таблицу списываемых товаров (исключаем услуги и сворачиваем дубли строк)
	ТаблицаТоваров = СписокНоменклатуры.Выгрузить();
	
	// Удаляем строки с услугами, так как их нет на складе
	Индекс = ТаблицаТоваров.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ТаблицаТоваров[Индекс].Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга Тогда
			ТаблицаТоваров.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	// Если в документе были только услуги, выходим из процедуры
	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Сворачиваем таблицу по Номенклатуре, чтобы просуммировать количество, 
	// если пользователь ввел один и тот же товар разными строками
	ТаблицаТоваров.Свернуть("Номенклатура", "Количество");
	
	// 3. НАСТРОЙКА УПРАВЛЯЕМОЙ БЛОКИРОВКИ
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	
	// На экзамене "1С:Специалист" для контроля остатков требуют ИСКЛЮЧИТЕЛЬНЫЙ режим
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	// Указываем конкретный склад из шапки документа
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
	
	// Передаем нашу подготовленную таблицу, чтобы заблокировать только нужные товары
	ЭлементБлокировки.ИсточникДанных = ТаблицаТоваров;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	
	// Блокируем данные в памяти сервера 1С [1]
	Блокировка.Заблокировать();
		
	// 4. ЗАПРОС ДЛЯ ПОЛУЧЕНИЯ ОСТАТКОВ И ПАРТИЙ
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.Количество КАК КоличествоВДокументе
		|ПОМЕСТИТЬ ВТ_Товары
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Товары.Номенклатура КАК Номенклатура,
		|	ВТ_Товары.КоличествоВДокументе КАК КоличествоВДокументе,
		|	ОстаткиНоменклатурыОстатки.Партия КАК Партия,
		|	ЕСТЬNULL(ОстаткиНоменклатурыОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	ЕСТЬNULL(ОстаткиНоменклатурыОстатки.СтоимостьОстаток, 0) КАК СтоимостьОстаток
		|ИЗ
		|	ВТ_Товары КАК ВТ_Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиНоменклатуры.Остатки(
		|				&МоментВремени,
		|				Склад = &Склад
		|					И Номенклатура В (ВЫБРАТЬ ВТ_Товары.Номенклатура ИЗ ВТ_Товары КАК ВТ_Товары)) КАК ОстаткиНоменклатурыОстатки
		|		ПО ВТ_Товары.Номенклатура = ОстаткиНоменклатурыОстатки.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	ОстаткиНоменклатурыОстатки.Партия.МоментВремени"; // FIFO: Сначала сортируем по времени создания партий

	// Передаем параметры в запрос
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	// На экзамене важно использовать МоментВремени(), чтобы не увидеть движения текущего документа
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());

	// Выполняем запрос
	РезультатЗапроса = Запрос.Выполнить();

КонецПроцедуры
